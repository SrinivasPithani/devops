// Check if a Future or Swap trade with the execution ID already exists and if yes, block the processing to prevent duplicate trades.
boolean tradeFound=false;
tradeFound = database.items(Future).SELECT(state!='deleted' && cfExecID==exec).COUNT()>0?true:false;
if (tradeFound==false) {
    tradeFound = database.items(Swap).SELECT(state!='deleted' && cfExecID==exec).COUNT()>0?true:false;    
}
if (tradeFound==true) { 
    fail("Blocked: trade with Execution ID already exists!"); 
}


// Block all Option trades
//test if stp SecurityId contains "O"
//if test passes this is an Option trade , therefore block stp record from creating a trade
if (substring(getToken(attrString('SecurityId'), "_", 1), 0, 1) == "O") {
    fail("Blocked: option trades not supported.");
}


database.updatedItems.FOREACH({d:
//cast it to its respective form
Swap s = cast(d.item, Swap);
Future f = cast(d.item, Future);
Deal deal = cast(d.item, Deal);


//declare variables to assign to the trades
string strTicket;
date contract;
string BS;
string px;
boolean sell;


date firstContract=attrDate('ContractDate');
date lastContract=attrDate('MaturityDate');
number totalMonths;


if (s!=null) 
{


string firstM;
string lastM;
string firstYear;
string lastYear;


      var inst = getToken(s.floatingLeg,'-',0);
      Instrument i = database.byName(inst, Instrument);
      number c=cast(i,PeriodicInstrument)!=null?cast(i,PeriodicInstrument).conversionFactor:
        (cast(i,DiffInstrument)!=null?cast(i,DiffInstrument).conversion:
           (cast(i,FormulaInstrument)!=null?cast(i,FormulaInstrument).conversionFactor:0));
      
       number signedLots=s.isSell==true?-attrNumber('Lots'):attrNumber('Lots');
       number LotSize=suggestedLotSize;
 
      if(isSpread==true || legs.COUNT()>0)
       {
          number legNumber=toNumber(getToken(s.externalId,':',1));
          var stpLeg=legs.SELECT(index==legNumber).FIRST();
          //LotSize=stpLeg.suggestedLotSize;
          signedLots=s.isSell==true?-stpLeg.lots:stpLeg.lots;
          firstContract=stpLeg.contractDate;
          lastContract=stpLeg.maturityDate;
          symbol=stpLeg.symbol;
          px = '';
              if(stpLeg.isBuy==true)
             {  BS = "B";  }
              else
             {  BS = "S";  }
      }
      else
      {
          px = format(s.fixedPrice,'#.###');
          BS = substring(attrString('BuySell'), 0, 1);
          firstContract=attrDate('ContractDate');
          lastContract=attrDate('MaturityDate');
      }
      if(getYear(lastContract)>getYear(firstContract))
      {
          totalMonths=(12-getMonth(firstContract))+(getYear(lastContract)-getYear(firstContract)-1)*12+getMonth(lastContract)+1;
      }
      else if(getYear(lastContract)==getYear(firstContract))
      {
          totalMonths=getMonth(lastContract)-getMonth(firstContract)+1; 
      }
 
          firstM = cFcn_mTOmmm(getMonth(firstContract));
          firstYear= substring(format(getYear(firstContract),'#'),2,2);
          lastM = cFcn_mTOmmm(getMonth(lastContract));
          lastYear= substring(format(getYear(lastContract),'#'),2,2);
      strTicket=symbol+"_"+firstM+firstYear+lastM+lastYear+"_"+px+BS;
      s.quantity=totalMonths*abs(signedLots)*LotSize;
      s.isExchangeTraded=true;
      s.counterparty=database.byName("IPE",Counterparty);
      s.exchange=database.byName("IPE",Counterparty);
      s.priceDisplayUom = s.fixedPriceUnit;
      s.ticket=strTicket;
      //s.comments=attrString('TradeID2');
      s.conversion=c;
      s.quantityPeriod = "per Trade";
      s.rounding = 4;
      s.firstPricingDay = firstContract;
      s.lastPricingDay = lastContract;
      s.tradeDate=attrDate('TradeDate');
      s.cfExecTime = execTime;
      s.cfEntry = "STP";
      s.cfExecID = exec;
      s.state='Committed';
}


if (f!=null) 
{
       if(legs.COUNT()>0)
      {
       number legNumber=toNumber(getToken(f.externalId,':',1));
       var stpLeg=legs.SELECT(index==legNumber).FIRST();
       contract = stpLeg.contractDate;
           if(stpLeg.isBuy==true)
          {  BS = "B";  }
           else
          {  BS = "S";  }
       px = format(stpLeg.price,'#.###');
       }
       else
       {
       contract = attrDate('ContractDate');
       px = format(f.price,'#.###');
       BS = substring(attrString('BuySell'), 0, 1);
       }
    string month = cFcn_mTOmmm(getMonth(contract));
    string year= substring(format(getYear(contract),'#'),2,2);
    strTicket=symbol+"_"+month+"-"+year+"_"+px+BS;
    f.ticket=strTicket;
    f.tradeDate=attrDate('TradeDate');
    f.cfExecTime = execTime;
    f.cfEntry = "STP";
    f.cfExecID = exec;
    f.state='Committed';


    //Change the price to 0.0001 if the trade is a TAS trade with 0 price
      if (f.price <= 0) {f.priceOriginal = 0.0001};
 /*     
      if(getYear(lastContract)>getYear(firstContract))      {
          totalMonths=(12-getMonth(firstContract))+(getYear(lastContract)-getYear(firstContract)-1)*12+getMonth(lastContract);
      }
      else if(getYear(lastContract)==getYear(firstContract))
      {
          totalMonths=getMonth(lastContract)-getMonth(firstContract); 
      }
      range(1,totalMonths+1).FOREACH({c:
          Future dealFut=construct(Future);
          dealFut=cast(f.copyItem(),Future);
          dealFut.name=database.generateName(Future);
          dealFut.contractName=formatDate(addMonths(f.contract,c),"yyyy-MM");
          dealFut.externalId=f.externalId+":"+formatDate(addMonths(f.contract,c),"yyyy-MM");
          dealFut.ticket=strTicket;
          dealFut.state='Committed';
          dealFut.comments=attrString('TradeID2');
          if (f.price <= 0) {dealFut.priceOriginal = 0.0001};
     })
*/
}


if (deal!=null) {
    
    if (deal.trader.parent.name=='Physical Traders') {
         Strategy strategy = database.items(Strategy).FIND(isDeleted==false && isClosed==false && name=='STP ICE HOLDING - HEDGING');
         if (strategy == null) 
        {
             fail('Strategy with name STP ICE HOLDING - HEDGING was not found. Please verify Strategy node setup.')               
        }
         else 
        {
           deal.strategy=strategy;
        }
    }
    else if (deal.trader.parent.name=='Proprietary Traders') {
         Strategy strategy = database.items(Strategy).FIND(isDeleted==false && isClosed==false && name=='STP ICE - PROPRIETARY');
         if (strategy == null) 
        {
             fail('Strategy with name STP ICE - PROPRIETARY was not found. Please review Strategy node setup.')               
        }
         else 
        {
           deal.strategy=strategy;
        }
    }
    else if (deal.trader.parent.name=='Proprietary and Hedging Traders') {
         Strategy strategy = database.items(Strategy).FIND(isDeleted==false && isClosed==false && name=='STP ICE - PROPRIETARY&HEDGING');
         if (strategy == null) 
        {
             fail('Strategy with name PROPRIETARY AND HEDGING STRATEGIES was not found. Please review Strategy node setup.')               
        }
         else 
        {
           deal.strategy=strategy;
        }
    }
    else {
        fail('The parent Trader node for '+deal.trader.name+' associated with this trade must be either Physical Traders, Proprietary Traders or Proprietary and Hedging Traders. Please review the Trader node setup.');
    }
}


});
