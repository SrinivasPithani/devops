string exec = attrString('ExecutionId');
string execTime = attrString('TimeIn');
string account = attrString('CustomerAccount');
date contract;
string BS;
string px;
boolean sell;


if (attrString("Type") == 'OPT')
{   fail("Blocked: option trades not supported.");   }

//Identify Futures that are Given-Up. 
if (attrString("TradeInputSource") == "FIRM") {
   fail("CME Future Give Ups are blocked in STP scripting as Trader and Broker Firm are not on STP record")
} 

if (s!=null) 
{
/*
date firstContract;
date lastContract;
number totalMonths;
*/
string firstM;
string lastM;
string firstYear;
string lastYear;


      var inst = getToken(s.floatingLeg,'-',0);
      Instrument i = database.byName(inst, Instrument);
      number c=cast(i,PeriodicInstrument)!=null?cast(i,PeriodicInstrument).conversionFactor:
        (cast(i,DiffInstrument)!=null?cast(i,DiffInstrument).conversion:
           (cast(i,FormulaInstrument)!=null?cast(i,FormulaInstrument).conversionFactor:0));
      
       /*
       number signedLots=s.isSell==true?-attrNumber('Lots'):attrNumber('Lots');
       number LotSize=suggestedLotSize;
      */
   
      s.setFirstAndLastDate(s.firstPricingDay, addDays(addMonths(toDate(formatDate(s.firstPricingDay,'yyyy-MM-01')),1),-1));
 
      if(isSpread==true || legs.COUNT()>0)
       {
          number legNumber=toNumber(getToken(s.externalId,':',1));
          var stpLeg=legs.SELECT(index==legNumber).FIRST();
          /*
          LotSize=stpLeg.suggestedLotSize;
          signedLots=s.isSell==true?-stpLeg.lots:stpLeg.lots;
          firstContract=stpLeg.contractDate;
          lastContract=stpLeg.maturityDate;
          */
          symbol=stpLeg.symbol;
          px = '';
              if(stpLeg.isBuy==true)
             {  BS = "B";  }
              else
             {  BS = "S";  }
      }
      else
      {
          px = format(s.fixedPrice,'#.###');
          BS = substring(attrString('BuySell'), 0, 1);
          /*
          firstContract=attrDate('ContractDate');
          lastContract=attrDate('MaturityDate');
          */
      }
      /*  
      if(getYear(lastContract)>getYear(firstContract))
      {
          totalMonths=(12-getMonth(firstContract))+(getYear(lastContract)-getYear(firstContract)-1)*12+getMonth(lastContract)+1;
      }
      else if(getYear(lastContract)==getYear(firstContract))
      {
          totalMonths=getMonth(lastContract)-getMonth(firstContract)+1; 
      }
      */
  
          firstM = cFcn_mTOmmm(getMonth(s.firstPricingDay));
          firstYear= substring(format(getYear(s.firstPricingDay),'#'),2,2);
          lastM = cFcn_mTOmmm(getMonth(s.lastPricingDay));
          lastYear= substring(format(getYear(s.lastPricingDay),'#'),2,2);
      strTicket=symbol+"_"+firstM+firstYear+lastM+lastYear+"_"+px+BS;
      //s.quantity=totalMonths*abs(signedLots)*LotSize;
      s.isExchangeTraded=true;
      s.counterparty=database.byName("NYMEX",Counterparty);
      s.exchange=database.byName("NYMEX",Counterparty);
      s.priceDisplayUom = s.fixedPriceUnit;
      s.ticket=strTicket;
      //s.comments=attrString('TradeID2');
      s.conversion=c;
      s.quantityPeriod = "per Trade";
      s.rounding = 4;
      /*
      s.firstPricingDay = firstContract;
      s.lastPricingDay = lastContract;
      */
      s.tradeDate=attrDate('TradeDate');
      s.cfExecTime = execTime;
      s.cfEntry = "STP";
      s.cfExecID = exec;
      s.cfBrokerAccount = account;
//      s.state='Committed';
}




if (f!=null) 
{
       if(legs.COUNT()>0)
      {
       number legNumber=toNumber(getToken(f.externalId,':',1));
       var stpLeg=legs.SELECT(index==legNumber).FIRST();
       contract = stpLeg.contractDate;
           if(stpLeg.isBuy==true)
          {  BS = "B";  }
           else
          {  BS = "S";  }
       px = format(stpLeg.price,'#.###');
       }
       else
       {
       contract = attrDate('ContractDate');
       px = format(f.price,'#.###');
       BS = substring(attrString('BuySell'), 0, 1);
       }
    string month = cFcn_mTOmmm(getMonth(contract));
    string year= substring(format(getYear(contract),'#'),2,2);
    strTicket=symbol+"_"+month+"-"+year+"_"+px+BS;
    f.ticket=strTicket;
    f.tradeDate=attrDate('TradeDate');
    f.cfExecTime = execTime;
    f.cfEntry = "STP";
    f.cfExecID = exec;
    f.cfBrokerAccount = account;
    //Change the price to 0.0001 if the trade is a TAS trade with 0 price
    if (f.price <= 0) {f.priceOriginal = 0.0001};
}

// If the trader has not been found through the mapping specified in the Traders tab then try and find it via the OrderEntryOperatorID field. The CME Trade ID needs to be specified on the cmeTraderId custom field of the Trader node. Where a trader has multiple CME Trader IDs then the different IDs must be comma separated
if (deal!=null && deal.trader == null) {
    
    string operatorId = attrString("OrderEntryOperatorID");
    var traderCol = database.items(Trader).SELECT(isDeleted==false);
    var cmeIdTraderCol = [[cmeId='',trader=traderCol.FIND(name=='')]].SELECT(1==2);
    traderCol.FOREACH({
        trader:
        splitTokens(trader.cmeTraderId,',').FOREACH({
            cmeId:
            cmeIdTraderCol = cmeIdTraderCol.MERGE([[cmeId=trim(cmeId),trader=trader]]);
        });
    });
    deal.trader = cmeIdTraderCol.FIND(cmeId==operatorId).trader;
}

if (deal.trader==null) {
    fail('The Trader has not been found. Please review the mapping specified on the Traders tab and in the Trader node setup.');
}

if (deal!=null) {
    
    if (deal.trader.parent.name=='Physical Traders') {
         Strategy strategy = database.items(Strategy).FIND(isDeleted==false && isClosed==false && name=='STP CME HOLDING - HEDGING');
         if (strategy == null) 
        {
             fail('Strategy with name STP CME HOLDING - HEDGING was not found. Please verify Strategy node setup.')               
        }
         else 
        {
           deal.strategy=strategy;
        }
    }
    else if (deal.trader.parent.name=='Proprietary Traders') {
         Strategy strategy = database.items(Strategy).FIND(isDeleted==false && isClosed==false && name=='STP CME - PROPRIETARY');
         if (strategy == null) 
        {
             fail('Strategy with name STP CME - PROPRIETARY was not found. Please review Strategy node setup.')               
        }
         else 
        {
           deal.strategy=strategy;
        }
    }
     else if (deal.trader.parent.name=='Proprietary and Hedging Traders') {
         Strategy strategy = database.items(Strategy).FIND(isDeleted==false && isClosed==false && name=='STP CME - PROPRIETARY&HEDGING');
         if (strategy == null) 
        {
             fail('Strategy with name PROPRIETARY AND HEDGING STRATEGIES was not found. Please review Strategy node setup.')               
        }
         else 
        {
           deal.strategy=strategy;
        }
    }
    else {
        fail('The parent Trader node for '+deal.trader.name+' associated with this trade must be either Physical Traders, Proprietary Traders or Proprietary and Hedging Traders. Please review the Trader node setup.');
    }
}


});
