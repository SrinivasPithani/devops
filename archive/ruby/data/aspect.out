    if (f.price <= 0) {f.priceOriginal = 0.0001};
}

// If the trader has not been found through the mapping specified in the Traders tab then try and find it via the OrderEntryOperatorID field. The CME Trade ID needs to be specified on the cmeTraderId custom field of the Trader node. Where a trader has multiple CME Trader IDs then the different IDs must be comma separated
if (deal!=null && deal.trader == null) {
    
    string operatorId = attrString("OrderEntryOperatorID");
    var traderCol = database.items(Trader).SELECT(isDeleted==false);
    var cmeIdTraderCol = [[cmeId='',trader=traderCol.FIND(name=='')]].SELECT(1==2);
    traderCol.FOREACH({
        trader:
        splitTokens(trader.cmeTraderId,',').FOREACH({
            cmeId:
            cmeIdTraderCol = cmeIdTraderCol.MERGE([[cmeId=trim(cmeId),trader=trader]]);
        });
    });
    deal.trader = cmeIdTraderCol.FIND(cmeId==operatorId).trader;
}

if (deal.trader==null) {
    fail('The Trader has not been found. Please review the mapping specified on the Traders tab and in the Trader node setup.');
}

if (deal!=null) {
    
    if (deal.trader.parent.name=='Physical Traders') {
         Strategy strategy = database.items(Strategy).FIND(isDeleted==false && isClosed==false && name=='STP CME HOLDING - HEDGING');
         if (strategy == null) 
        {
             fail('Strategy with name STP CME HOLDING - HEDGING was not found. Please verify Strategy node setup.')               
        }
         else 
        {
           deal.strategy=strategy;
        }
    }
    else if (deal.trader.parent.name=='Proprietary Traders') {
         Strategy strategy = database.items(Strategy).FIND(isDeleted==false && isClosed==false && name=='STP CME - PROPRIETARY');
         if (strategy == null) 
        {
             fail('Strategy with name STP CME - PROPRIETARY was not found. Please review Strategy node setup.')               
        }
         else 
        {
           deal.strategy=strategy;
        }
    }
     else if (deal.trader.parent.name=='Proprietary and Hedging Traders') {
         Strategy strategy = database.items(Strategy).FIND(isDeleted==false && isClosed==false && name=='STP CME - PROPRIETARY&HEDGING');
         if (strategy == null) 
        {
             fail('Strategy with name PROPRIETARY AND HEDGING STRATEGIES was not found. Please review Strategy node setup.')               
        }
         else 
        {
           deal.strategy=strategy;
        }
    }
    else {
        fail('The parent Trader node for '+deal.trader.name+' associated with this trade must be either Physical Traders, Proprietary Traders or Proprietary and Hedging Traders. Please review the Trader node setup.');
    }
}


});
