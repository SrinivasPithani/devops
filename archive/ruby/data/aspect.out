      */
  
          firstM = cFcn_mTOmmm(getMonth(s.firstPricingDay));
          firstYear= substring(format(getYear(s.firstPricingDay),'#'),2,2);
          lastM = cFcn_mTOmmm(getMonth(s.lastPricingDay));
          lastYear= substring(format(getYear(s.lastPricingDay),'#'),2,2);
      strTicket=symbol+"_"+firstM+firstYear+lastM+lastYear+"_"+px+BS;
      //s.quantity=totalMonths*abs(signedLots)*LotSize;
      s.isExchangeTraded=true;
      s.counterparty=database.byName("NYMEX",Counterparty);
      s.exchange=database.byName("NYMEX",Counterparty);
